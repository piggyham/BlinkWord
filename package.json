{
  "name": "blinkword",
  "productName": "翻译小卡片",
  "version": "0.1.0",
  "description": "划词翻译小卡片 + 单词本 + 背单词桌面应用",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo-popup",
    "test": "node test/webdav.test.js",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "build": {
    "appId": "com.piggyham.blinkword",
    "productName": "翻译小卡片",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BlinkWord-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "BlinkWord-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2",
    "uiohook-napi": "^1.2.0"
  }
}
